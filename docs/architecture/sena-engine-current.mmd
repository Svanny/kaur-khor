flowchart TD
    UI["Renderer / UI"] --> IPC["Electron IPC<br/>src/main/index.ts"]
    IPC --> MC["Managed core controller<br/>src/main/core-manager.ts"]
    MC --> Q["Single active request queue<br/>src/main/backend.ts"]
    Q --> CORE["desktop-core process<br/>apps/desktop-core/src/main.rs"]

    CORE --> LOOP["stdin line loop<br/>one command handled at a time"]
    LOOP --> CMD{"Command"}
    CMD -->|sena.triggerRun| TR["store::trigger_run(...)"]
    CMD -->|read APIs| READS["get summary / detail / diagnostics"]

    TR --> CR["trigger_analysis_run()<br/>create run record"]
    CR --> ER["execute_analysis_run()"]
    ER --> LOAD["load catalog + observations"]
    LOAD --> RA["run_analysis(...)<br/>apps/sena-core/src/inference.rs"]
    RA --> SAVE["persist completed run"]
    SAVE --> RESP["response returned to UI"]
    READS --> RESP

    subgraph Kernel["SENA inference kernel: current execution"]
        RA --> I["for each interval"]
        I --> P["for each particle"]
        P --> STEP["step_particle(...)"]
        STEP --> W["weight + ESS + resample decision"]
        W --> NEXT["next interval"]
        NEXT --> I
        W --> POST["after intervals:<br/>reduce SKU traces, service traces, diagnostics"]
    end

    classDef hot fill:#fbe4d5,stroke:#b85c38,color:#2b211b,stroke-width:2px;
    classDef queue fill:#dceeff,stroke:#3b82f6,color:#10243e,stroke-width:1.5px;
    classDef storage fill:#e8f5e9,stroke:#4f8a5b,color:#17331f,stroke-width:1.5px;

    class Q,LOOP,TR,ER,RA,I,P,STEP,W,POST hot;
    class IPC,MC,Q queue;
    class LOAD,SAVE storage;
