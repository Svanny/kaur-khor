%% Banji record update benchmark flowchart. This is a control/data-flow diagram, not a timing chart.
%%{init: {"flowchart": {"curve": "basis", "htmlLabels": true, "nodeSpacing": 42, "rankSpacing": 58}, "theme": "base", "themeVariables": {"fontFamily": "Inter, ui-sans-serif, system-ui", "primaryColor": "#f8fafc", "primaryTextColor": "#111827", "primaryBorderColor": "#64748b", "lineColor": "#475569", "secondaryColor": "#eef2ff", "tertiaryColor": "#ecfeff", "clusterBkg": "#ffffff", "clusterBorder": "#cbd5e1"}}}%%
flowchart LR
  Start(["Record update benchmark starts"]):::entry

  subgraph Bench["Benchmark scenario"]
    Launch["Launch record-update-hub-current-flows"]:::process
    WaitWorkspace["Wait for renderer.workspace.ready"]:::metric
    MeasureStart["benchmark.phase.measurement_start"]:::metric
    ReturnHub["returnToRecordUpdateHub"]:::process
    LaneLoop["Open hub lanes<br/>stock, supplier, immediate sale, customer"]:::process
    StockSave["benchmarkStockCountSave"]:::process
    SupplierSave["benchmarkSupplierReceiptSave"]:::process
    MeasureEnd["benchmark.phase.measurement_end"]:::metric
  end

  subgraph Route["Record Update route"]
    Hub["Choose an update lane"]:::route
    TicketPrompt{"New or Edit/Update?"}:::decision
    Lane["Lane workbench"]:::route
    TileDialog["First workbench tile dialog"]:::route
    ReviewDialog["Review update or Confirm receipt dialog"]:::route
    DashboardReady["route.dashboard.ready after save"]:::metric
    RouteReady["route.record-update.ready"]:::metric
  end

  subgraph Data["Record update data"]
    Inventory["InventoryProvider"]:::process
    Context["sena.getRecordUpdateContext<br/>latest anchors"]:::ipc
    Orders["ticket and order batch context"]:::ipc
    Catalog["catalog and summary state"]:::cache
  end

  subgraph Core["Bridge, main, and desktop-core"]
    Preload["sena bridge<br/>invokeWithBenchmark"]:::bridge
    MainCache["main read cache"]:::cache
    ReadWorkers["read-worker pool for context reads"]:::ipc
    Writer["writer core for save mutations"]:::mutation
    Store["ticket events, record anchors, catalog, hot summaries"]:::store
    Generation["mutation generation bump<br/>invalidate stale reads"]:::cache
  end

  subgraph Metrics["Target coverage"]
    OpenMetric["interaction.open_record_update_ms"]:::metric
    LaneMetric["nav.record_update_hub_to_lane_ms"]:::metric
    StockMetric["interaction.save_stock_count_ms"]:::metric
    SupplierMetric["interaction.save_supplier_order_receipt_ms"]:::metric
    Memory["renderer memory snapshots per lane"]:::metric
    Summary["record-update.summary.json"]:::metric
  end

  Start --> Launch --> WaitWorkspace --> MeasureStart --> ReturnHub --> Hub
  Hub --> LaneLoop --> TicketPrompt
  TicketPrompt -- "New or direct lane" --> Lane --> RouteReady
  TicketPrompt -- "Edit/Update existing ticket" --> Lane --> RouteReady
  RouteReady --> LaneMetric --> Memory
  LaneLoop --> ReturnHub
  ReturnHub --> StockSave --> Lane --> TileDialog --> ReviewDialog --> Writer
  Writer --> Store --> Generation --> DashboardReady --> StockMetric
  ReturnHub --> SupplierSave --> TicketPrompt --> Lane --> TileDialog --> ReviewDialog --> Writer
  DashboardReady --> SupplierMetric
  SupplierSave --> MeasureEnd --> Summary

  Lane --> Inventory
  Inventory --> Catalog
  Inventory --> Context --> Preload
  Inventory --> Orders --> Preload
  Preload --> MainCache
  MainCache -- "hit" --> Lane
  MainCache -- "miss" --> ReadWorkers --> Store --> MainCache
  ReviewDialog --> Preload --> Writer

  OpenMetric --> Summary
  LaneMetric --> Summary
  StockMetric --> Summary
  SupplierMetric --> Summary
  Memory --> Summary

  classDef entry fill:#ecfeff,stroke:#0891b2,stroke-width:2px,color:#0f172a;
  classDef process fill:#f8fafc,stroke:#64748b,stroke-width:1.2px,color:#111827;
  classDef decision fill:#fff7ed,stroke:#ea580c,stroke-width:1.4px,color:#111827;
  classDef route fill:#f0f9ff,stroke:#0284c7,stroke-width:1.4px,color:#111827;
  classDef ipc fill:#eef2ff,stroke:#4f46e5,stroke-width:1.4px,color:#111827;
  classDef cache fill:#f0fdf4,stroke:#16a34a,stroke-width:1.4px,color:#111827;
  classDef bridge fill:#fdf2f8,stroke:#db2777,stroke-width:1.4px,color:#111827;
  classDef store fill:#fefce8,stroke:#ca8a04,stroke-width:1.4px,color:#111827;
  classDef metric fill:#eff6ff,stroke:#2563eb,stroke-width:1.4px,color:#111827;
  classDef mutation fill:#ffedd5,stroke:#ea580c,stroke-width:1.6px,color:#111827;
