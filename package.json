{
  "name": "banji",
  "version": "0.1.5",
  "private": true,
  "description": "Electron desktop inventory workspace for banji, with a bundled Rust desktop-core runtime for local persistence and analysis flows.",
  "author": {
    "name": "Svanny",
    "email": "svanny@users.noreply.github.com"
  },
  "homepage": "https://github.com/Svanny/banji",
  "repository": {
    "type": "git",
    "url": "https://github.com/Svanny/banji.git"
  },
  "bugs": {
    "url": "https://github.com/Svanny/banji/issues"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm data:generate && electron-vite dev --watch",
    "data:generate": "python3 ./scripts/generate_dev_history.py --years 5 --interval-days 3.5",
    "data:generate:force": "python3 ./scripts/generate_dev_history.py --years 5 --interval-days 3.5 --force",
    "data:generate:screenshot": "python3 ./scripts/generate_dev_history.py --years 5 --interval-days 1 --force --use-bundled-dev-catalog",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "pages:build": "pnpm run build:web && cp out/web/index.html out/web/404.html",
    "build:icon": "bash ./scripts/build-macos-icon.sh",
    "package:mac": "bash ./scripts/package-mac.sh",
    "package:linux": "bash ./scripts/package-linux.sh",
    "package:win:native": "node ./scripts/package-win-native.mjs",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts",
    "bench": "node ./scripts/run-benchmarks.mjs",
    "bench:startup": "node ./scripts/run-benchmarks.mjs bench/scenarios/startup.bench.ts",
    "bench:navigation": "node ./scripts/run-benchmarks.mjs bench/scenarios/navigation.bench.ts",
    "bench:work": "node ./scripts/run-benchmarks.mjs bench/scenarios/work.bench.ts",
    "bench:capture": "node ./scripts/run-benchmarks.mjs bench/scenarios/capture.bench.ts",
    "bench:detail-pages": "node ./scripts/run-benchmarks.mjs bench/scenarios/detail-pages.bench.ts",
    "bench:stability": "node ./scripts/run-benchmarks.mjs bench/scenarios/stability.bench.ts",
    "bench:compare": "node ./scripts/compare-benchmarks.mjs",
    "bench:run": "node ./scripts/run-benchmarks.mjs",
    "markmap:user-decision-tree": "markmap docs/development/user-decision-tree.markmap.md --offline --no-open -o docs/development/user-decision-tree.markmap.html",
    "markmap:user-decision-tree:watch": "markmap docs/development/user-decision-tree.markmap.md --offline -o docs/development/user-decision-tree.markmap.html --watch",
    "refresh:tree": "bash ./scripts/refresh-tree.sh",
    "refresh:tree:zsh": "zsh ./scripts/refresh-tree.zsh",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lightweight-charts": "5.1.0",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "react-sparklines": "^1.7.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "30.5.1",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.2.0",
    "markmap-cli": "^0.18.12",
    "playwright": "^1.59.1",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "msw"
    ]
  }
}
