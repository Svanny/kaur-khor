flowchart TB

subgraph RUNTIME["Banji Runtime Plane (Current)"]
  direction TB

  client["Client Apps"] --> api["Rust API (axum)<br/>/health<br/>/v1/write-demo"]
  runtime_secrets["Railway runtime secrets"] --> cfg["AppConfig + startup validation<br/>redacted Debug"] --> api

  api --> sqlxpool["SQLx pool<br/>warmup before ready<br/>graceful drain on shutdown"]
  sqlxpool --> pgbouncer["PgBouncer<br/>transaction mode"]
  pgbouncer --> pg_core[("Postgres core<br/>app.idempotency_request<br/>app.event_log<br/>app.job_outbox<br/>app.event_consumer_checkpoint")]

  pg_core --> relay["Outbox relay<br/>publisher confirms"] --> rabbit["RabbitMQ jobs"]
  rabbit --> workers["Workers<br/>fast/heavy + manual ack"] --> pg_state[("Postgres state writes")]
  workers --> classifier["Error classifier<br/>permanent->DLQ<br/>transient->retry"] --> rabbit
  replay["DLQ replay tool<br/>rate-limited + audited"] --> rabbit

  pg_core --> projection["Projection consumer<br/>poll by created_at,id"] --> pg_state

  cfg --> redis[("Redis optional<br/>cache + coordination")]
  redis -. behavior .-> redis_policy["Fail-open + fail-fast<br/>timeouts + circuit breaker<br/>TTL jitter + single-flight"]
  pg_core -. future mirror .-> kafka["Kafka optional future<br/>not active"]

  api --> otel_mw["HTTP telemetry middleware<br/>W3C propagation + correlation_id"]
  otel_mw --> semconv["HTTP SemConv metrics<br/>request.duration + active_requests"]
  sqlxpool --> db_metrics["DB pool metrics<br/>acquire failures + wait"]
  relay --> msg_headers["Message headers<br/>x-correlation-id + traceparent"]
  workers --> msg_headers
  projection --> msg_headers

  semconv --> collector["OTel Collector (internal)<br/>batch + memory_limiter"]
  db_metrics --> collector
  msg_headers --> collector
  collector --> grafana["Grafana Cloud<br/>traces + metrics"]

  api --> plogs["Platform logs (primary)<br/>Railway/log drain"]
  workers --> plogs
  projection --> plogs
end

subgraph DRILLS["Restore Drill Controls"]
  direction TB
  repo["GitHub repo + PR"] --> actions["GitHub Actions<br/>most workflows disabled"] --> drillwf["postgres-restore-drill<br/>enabled"]

  prodsrc["Secret<br/>RESTORE_DRILL_SOURCE_PROD_DATABASE_URL"] --> route["Weekly route<br/>prod -> staging_restore"]
  drillwf --> route --> restore_script["tool/db/restore_validate.sh<br/>hard safety invariants"]
  restore_script --> validate_sql["tool/db/validate_restore.sql<br/>schema + index + invariant checks"]
  validate_sql --> artifacts["Artifacts<br/>report_<env>.json<br/>validate_<env>.txt"]
  restore_script --> cleanup["Success cleanup<br/>drop restored objects"]

  drillwf --> dispatch["workflow_dispatch<br/>target_env=dev|staging|prod"]
  dispatch --> confirm["Prod confirmation required<br/>CONFIRM_PROD_RESTORE"]
  confirm --> alerts["Failure webhook (optional)<br/>always writes step summary"]
end

subgraph CONTRACTS["Reference Contracts"]
  direction LR
  c_naming["Naming<br/>banji-core + env + kh-pp<br/>topics/queues omit region"]
  c_secrets["Secrets boundary<br/>tracked templates use placeholders only<br/>least privilege by service"]
  c_pool["Pooling<br/>DATABASE_RUNTIME_ENDPOINT_KIND<br/>PGBOUNCER_POOL_MODE<br/>SQLX_POOL_* + budget"]
  c_restore["Restore invariants<br/>target ends _restore<br/>source != target<br/>weekly + monthly cadence"]
  c_logging["Logging split<br/>platform logs for ops<br/>Postgres event_log for audit/replay"]
end

