class otel_mw,semconv,db_metrics,msg_headers,collector,grafana,plogs obs;
class runtime_secrets,repo,actions,drillwf,prodsrc,route,restore_script,validate_sql,artifacts,cleanup,dispatch,confirm,alerts,c_naming,c_secrets,c_pool,c_restore,c_logging control;
class redis,redis_policy,kafka optional;
