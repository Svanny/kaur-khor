flowchart TB

subgraph FLOW["Banji Runtime Flow (Current)"]
  direction TB

  client["Client Apps"] --> api["Rust API (axum)<br/>/health<br/>/v1/write-demo"]

  api --> idemp[("Postgres<br/>app.idempotency_request")]
  api --> evlog[("Postgres<br/>app.event_log")]
  api --> outbox[("Postgres<br/>app.job_outbox")]
  api --> redis[("Redis optional<br/>cache + coordination")]

  outbox --> relay["Outbox relay<br/>publish with confirms<br/>mark sent"]
  relay --> rabbit["RabbitMQ jobs"]

  rabbit --> workers["Workers<br/>fast/heavy<br/>manual ack"]
  workers --> classifier["Error classifier<br/>permanent->DLQ<br/>transient->retry"]
  classifier --> rabbit
  workers --> pgstate[("Postgres state writes")]

  projection["Projection consumer<br/>poll by stream/id"] --> evlog
  projection --> checkpoint[("Postgres<br/>app.event_consumer_checkpoint")]

  operator["Operators"] --> replay["DLQ replay tool<br/>rate limit + audit"]
  operator --> dbtools["DB tools<br/>replay/export/restore validate"]
  replay --> rabbit
  dbtools --> evlog

  github["GitHub repo + PR"] --> gha["Actions disabled<br/>(.yml.disabled)"]
  evlog -. "optional future mirror" .-> kafka["Kafka optional future<br/>not active"]
end

subgraph DETAILS["Reference Panels"]
  direction LR

  naming["Naming<br/>banji-core<br/>env: dev|staging|prod<br/>region: kh-pp<br/>queue/topic names omit region"]

  rabbitDetail["Rabbit topology<br/>exchange: {system}.{env}.jobs<br/>dlx: {system}.{env}.jobs.dlx<br/>fast lane: primary + retry.1(30s) + retry.2(5m) + retry.3(30m) + dlq<br/>heavy lane: primary + retry.1(30s) + retry.2(5m) + retry.3(30m) + dlq"]

  pgDetail["Postgres objects<br/>_sqlx_migrations<br/>app.idempotency_request<br/>app.event_log<br/>app.event_consumer_checkpoint<br/>app.job_outbox<br/>app.event_log_archive_export_cursor<br/>app.event_log_archive (optional)"]

  redisDetail["Redis behavior<br/>fail-open + fail-fast<br/>timeouts + circuit breaker<br/>TTL jitter + single-flight"]
end

api -. "contract" .-> naming
rabbit -. "topology" .-> rabbitDetail
pgstate -. "schema" .-> pgDetail
redis -. "runtime" .-> redisDetail

%% Styling
classDef db fill:#e8f5e9,stroke:#2e7d32,color:#0f172a;
classDef mq fill:#e3f2fd,stroke:#1565c0,color:#0f172a;
classDef critical fill:#fff3e0,stroke:#ef6c00,color:#0f172a;
classDef optional fill:#f8fafc,stroke:#64748b,stroke-dasharray: 4 4,color:#0f172a;

class idemp,evlog,outbox,pgstate,checkpoint,pgDetail db;
class rabbit,rabbitDetail mq;
class api,relay,workers,classifier critical;
class redis,redisDetail,gha,kafka optional;
