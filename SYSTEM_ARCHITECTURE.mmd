flowchart TB

subgraph L0["0) How To Read"]
  direction LR
  legend_active["Solid arrow = active path"]
  legend_planned["Dashed arrow = planned or disabled"]
  legend_store[("Durable data store")]
  legend_async{"Async boundary / broker"}
  legend_control["Contract, policy, or tooling"]
  legend_active --> legend_store
  legend_control --> legend_async
  legend_planned -.-> legend_async
end

subgraph L1["1) Product Surface (Flutter)"]
  direction TB
  banji_app["<b>BanjiApp</b><br/>bootstrap in lib/main.dart"]
  app_scopes["App scopes<br/>LocaleController<br/>CurrencyController<br/>InventoryController"]
  home_view["HomeView"]
  inventory_views["Inventory routes<br/>ViewAll, SKU/Service detail<br/>UpdateStock, ProductRanking"]
  settings_view["SettingsView<br/>language + currency"]
  seed_state["Current local runtime model<br/>InventoryState.initial() seeded lists"]
  sec_utils["Security helpers<br/>security_validators.dart + id_generator.dart"]
  flutter_to_api["Planned Flutter -> API integration"]
  banji_app --> app_scopes --> home_view
  home_view --> inventory_views
  home_view --> settings_view
  app_scopes --> seed_state
  inventory_views --> sec_utils
  inventory_views -. planned integration .-> flutter_to_api
end

subgraph L2["2) API Ingress + Runtime (apps/api)"]
  direction TB
  callers["Client callers"]
  ingress["Ingress policy<br/>dev: direct<br/>staging/prod: Cloudflare edge-enforced"]
  env_contract["Runtime env templates<br/>config/env/dev|staging|prod.env"]
  app_cfg["AppConfig::from_env<br/>startup validation + redacted debug"]
  api["<b>Axum API</b><br/>/health<br/>/v1/write-demo"]
  middleware["Locked middleware chain<br/>origin guard -> size limit -> rate limit -> CORS -> observability"]
  db_pool["SQLx pool lifecycle<br/>build -> warmup SELECT 1 -> graceful close"]
  idempotency["Idempotency flow<br/>x-caller-id + idempotency-key<br/>check_or_claim_tx + complete_tx"]
  singleflight["In-process singleflight locks"]
  redis["Redis optional cache/coordination<br/>fail-open + timeout/circuit controls"]
  write_tx["write-demo transaction boundary"]
  callers --> ingress --> api
  env_contract --> app_cfg --> api
  api --> middleware --> idempotency
  api --> db_pool --> write_tx
  idempotency --> singleflight
  idempotency --> redis
  idempotency --> write_tx
end

subgraph L3["3) Data + Messaging Backbone"]
  direction TB
  pg_core[("Postgres app schema<br/>idempotency_request<br/>event_log<br/>job_outbox<br/>event_consumer_checkpoint")]
  outbox_relay["Outbox relay<br/>claim -> publish_with_confirm -> mark_sent"]
  rabbit["RabbitMQ quorum topology<br/>fast-jobs + heavy-jobs"]
  workers["Workers / consumers<br/>ack only after confirmed handoff"]
  retry["Retry ladder<br/>retry.1 30s -> retry.2 5m -> retry.3 30m"]
  dlq["DLQ (*.dlq)"]
  replay["Replay tooling<br/>copy-first replay + scoped cleanup"]
  event_consumer["Event consumers<br/>ORDER BY id ASC + checkpoints + lag"]
  event_archive["Event archive/prune<br/>JSONL export + eligible_max_id gates"]
  write_tx --> pg_core
  pg_core --> outbox_relay --> rabbit
  rabbit --> workers --> pg_core
  workers --> retry --> rabbit
  workers --> dlq
  retry --> dlq
  dlq --> replay --> rabbit
  pg_core --> event_consumer --> pg_core
  pg_core --> event_archive
end

subgraph L4["4) Observability + Logging"]
  direction TB
  otel_http["HTTP observability middleware<br/>x-correlation-id + W3C trace propagation"]
  db_metrics["DB metric sampler<br/>pool size, idle, acquire failures"]
  msg_headers["Message headers<br/>x-correlation-id + traceparent/tracestate/baggage"]
  collector["OTel Collector<br/>tool/otel/collector.yaml<br/>batch + memory_limiter"]
  grafana["Grafana Cloud OTLP sink<br/>traces + metrics"]
  platform_logs["Platform logs (primary)<br/>Railway / log drain"]
  audit_stream[("Postgres event_log<br/>audit/replay stream<br/>not primary ops log sink")]
  api --> otel_http --> collector
  db_pool --> db_metrics --> collector
  outbox_relay --> msg_headers --> collector
  workers --> msg_headers
  collector --> grafana
  api --> platform_logs
  workers --> platform_logs
  event_consumer --> platform_logs
  pg_core --> audit_stream
end

subgraph L5["5) Delivery + Operations"]
  direction TB
  workflows["Disabled workflow templates<br/>rust-ci, deploy, release-build<br/>event-log-maintenance, postgres-restore-drill"]
  release_contract["Release contract<br/>migration lock -> migrate -> deploy digest -> traffic shift"]
  restore_flow["Restore drill template<br/>scheduled prod -> staging_restore<br/>manual dev|staging|prod (prod confirmation)"]
  restore_script["tool/db/restore_validate.sh"]
  validate_sql["tool/db/validate_restore.sql"]
  restore_db[("Restore target DB<br/>must end with _restore")]
  drill_artifacts["Artifacts<br/>report_<env>.json + validate_<env>.txt"]
  edge_tools["Edge apply/verify scripts<br/>tool/edge/cloudflare_apply.sh<br/>tool/edge/cloudflare_verify.sh"]
  security_gate["Security gate<br/>tool/security/run_security_checks.sh"]
  workflows -. disabled .-> release_contract
  workflows -. disabled .-> restore_flow
  restore_flow --> restore_script --> validate_sql
  restore_script --> restore_db
  validate_sql --> restore_db
  validate_sql --> drill_artifacts
  release_contract --> edge_tools
  release_contract --> security_gate
end

subgraph L6["6) Planned / Future Track (Non-Active)"]
  direction TB
  kafka["Kafka transport option<br/>currently replaced by Postgres event_log"]
  shard_model["Consumer claim/sharding model<br/>for horizontal scale"]
  partition_trigger["Partitioning ADR trigger<br/>event_log > 50 GB OR prune > 1M/day for 7 days"]
  service_split["Potential service split<br/>outbox-relay / projection-consumer / scheduler"]
  otel_logs["OTEL logs pipeline (future)<br/>currently disabled"]
  flutter_to_api -. planned rollout .-> api
  pg_core -. future mirror .-> kafka
  event_consumer -. future scaling .-> shard_model
  event_archive -. scale trigger .-> partition_trigger
  api -. future deploy shape .-> service_split
  collector -. future option .-> otel_logs
end

