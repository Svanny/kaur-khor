flowchart TB

subgraph L0["0) How To Read"]
  direction LR
  legend_active["Solid arrow = active runtime/data path"]
  legend_planned["Dashed arrow = staged or not yet wired"]
  legend_store[("Durable store / external system")]
  legend_role["Runtime role / process"]
  legend_contract["Contract, policy, or bounded control"]
  legend_active --> legend_role
  legend_role --> legend_store
  legend_planned -.-> legend_contract
end

subgraph L1["1) Product Surface (Flutter Prototype)"]
  direction TB
  app_shell["<b>BanjiApp</b><br/>lib/main.dart"]
  app_scopes["App-local scopes<br/>LocaleController<br/>CurrencyController<br/>InventoryController"]
  home_view["HomeView<br/>dashboard shell + navigation"]
  inventory_flows["Inventory flows<br/>ViewAll, SKU/Service detail<br/>UpdateStock, ProductRanking"]
  settings_view["SettingsView<br/>language + currency"]
  local_state["In-memory seed state<br/>InventoryState.initial()<br/>4 SKUs + 2 services"]
  l10n_display["Localization + display helpers<br/>en/km + USD/KHR labels"]
  shared_helpers["Shared safety helpers<br/>security_validators.dart<br/>security_limits.dart<br/>id_generator.dart"]
  frontend_gap["Frontend API/data sync<br/>not wired yet"]
  app_shell --> app_scopes --> home_view
  home_view --> inventory_flows
  home_view --> settings_view
  app_scopes --> local_state
  inventory_flows --> l10n_display
  inventory_flows --> shared_helpers
  inventory_flows -. planned integration .-> frontend_gap
end

subgraph L2["2) Client Access + Edge Ingress"]
  direction TB
  operators["Operators / browser / future mobile client"]
  cloudflare["Cloudflare front door<br/>required in staging/prod"]
  dev_direct["Dev direct access<br/>no Cloudflare requirement"]
  edge_chain["Locked ingress order<br/>origin guard -> request-size limit -> CORS -> observability"]
  route_chain["Application route chain<br/>auth -> identity(device id)<br/>backpressure -> rate limit -> handlers"]
  operators --> cloudflare --> edge_chain --> route_chain
  operators -. dev .-> dev_direct --> edge_chain
end

subgraph L3["3) API Runtime (APP_ROLE=api)"]
  direction TB
  env_cfg["AppConfig::from_env<br/>startup validation + redacted config debug"]
  api_runtime["<b>Axum API</b><br/>/health<br/>POST /v1/items<br/>GET /v1/items/:item_id<br/>POST /v1/write-demo"]
  auth_scope["JWT auth + owner scope<br/>device-id required on /v1/*"]
  idempotency["Idempotency contract<br/>Postgres correctness gate<br/>request hash by method + route + body"]
  singleflight["In-process singleflight<br/>hot-key suppression"]
  redis["Redis fail-open helper<br/>rate-limit + cache + coordination"]
  db_pool["SQLx runtime pool<br/>warmup SELECT 1<br/>PgBouncer transaction mode in staging/prod"]
  read_path["Current read path<br/>GET /v1/items reads canonical table<br/>not projection yet"]
  route_chain --> auth_scope --> api_runtime
  env_cfg --> api_runtime
  api_runtime --> idempotency
  idempotency --> singleflight
  idempotency --> redis
  auth_scope --> redis
  api_runtime --> db_pool
  api_runtime --> read_path
end

subgraph L4["4) Canonical Postgres Write Path"]
  direction TB
  write_tx["Single request transaction<br/>validate -> canonical write<br/>enqueue async intent -> complete idempotency"]
  pg_core[("Postgres app schema<br/>inventory_item<br/>idempotency_request")]
  event_outbox[("app.event_outbox<br/>event intent in same tx")]
  job_outbox[("app.job_outbox<br/>job enqueue intent in same tx")]
  job_tables[("Job accountability tables<br/>job_run<br/>job_run_attempt<br/>job_result<br/>job_delivery_violation")]
  projection_table[("app.inventory_item_projection<br/>derived read model")]
  backfill_table[("app.backfill_run<br/>audited replay/backfill state")]
  artifact_meta[("Artifact metadata only<br/>object_artifact<br/>job_result_artifact")]
  api_runtime --> write_tx
  write_tx --> pg_core
  write_tx --> event_outbox
  write_tx --> job_outbox
  write_tx --> job_tables
  read_path --> pg_core
end

subgraph L5["5) Async Runtime Roles"]
  direction TB
  event_relay["<b>APP_ROLE=event-relay</b><br/>claim event_outbox batch<br/>publish to event_log by publish_key"]
  projection_consumer["<b>APP_ROLE=projection-consumer</b><br/>single active consumer<br/>continuous | replay-preview | replay-apply"]
  worker["<b>APP_ROLE=worker</b><br/>relay job_outbox -> RabbitMQ<br/>consume primary + replay queues<br/>attempt lease + heartbeat + retries"]
  backfill["<b>APP_ROLE=backfill-controller</b><br/>projection replay + job backfill<br/>primary or restore DB"]
  event_outbox --> event_relay
  job_outbox --> worker
  event_log --> projection_consumer
  projection_consumer --> projection_table
  event_log --> backfill
  backfill --> backfill_table
  backfill --> projection_table
  backfill --> job_outbox
end

subgraph L6["6) Messaging + Durable Stores"]
  direction TB
  event_log[("app.event_log<br/>append-only audit + replay stream")]
  checkpoints[("app.event_consumer_checkpoint<br/>cursor + lag state")]
  rabbit["RabbitMQ quorum topology<br/>fast-jobs | heavy-jobs<br/>retry.1/2/3 | *.dlq | replay exchange"]
  object_store[("S3-compatible object storage<br/>heavy worker artifacts")]
  event_archive[("Object-storage JSONL archive<br/>export before prune")]
  restore_db[("Restore database<br/>*_restore validation target")]
  event_relay --> event_log
  projection_consumer --> checkpoints
  worker --> rabbit
  rabbit --> worker
  worker --> job_tables
  worker --> object_store
  object_store --> artifact_meta
  event_log --> event_archive
  backfill --> restore_db
end

subgraph L7["7) Observability + Delivery + Operations"]
  direction TB
  corr_trace["Trace + correlation contract<br/>x-correlation-id<br/>traceparent/tracestate/baggage"]
  otel["OTel collector<br/>batch + memory_limiter"]
  grafana["Grafana Cloud OTLP sink<br/>traces + metrics"]
  platform_logs["Platform-first operational logs<br/>Railway / log drain"]
  runtime_topology["Role topology contract<br/>api | event-relay<br/>projection-consumer | worker<br/>backfill-controller on demand"]
  release_flow["Release flow<br/>migrate_with_lock -> deploy event-relay<br/>-> projection-consumer -> worker -> api<br/>-> verify same-revision parity"]
  edge_ops["Cloudflare apply/verify<br/>fingerprint-based drift checks"]
  maintenance["Maintenance runbooks<br/>event archive/prune<br/>restore drills<br/>DLQ triage + replay"]
  api_runtime --> corr_trace
  event_relay --> corr_trace
  projection_consumer --> corr_trace
  worker --> corr_trace
  backfill --> corr_trace
  corr_trace --> otel --> grafana
  api_runtime --> platform_logs
  event_relay --> platform_logs
  projection_consumer --> platform_logs
  worker --> platform_logs
  backfill --> platform_logs
  release_flow --> runtime_topology
  release_flow --> edge_ops
  release_flow --> cloudflare
  maintenance --> event_archive
  maintenance --> restore_db
  maintenance --> rabbit
end

frontend_gap -. planned rollout .-> api_runtime

