flowchart TB

subgraph FLOW["Banji Runtime Plane (Current)"]
  direction TB

  client["Client Apps"] --> api["Rust API (axum)<br/>/health<br/>/v1/write-demo"]
  rsecrets["Railway service secrets<br/>runtime secret source"] --> api

  api --> config["AppConfig + startup validation<br/>manual Debug redaction"]
  api --> otelmw["HTTP observability middleware<br/>correlation precedence + W3C extract/inject<br/>response x-correlation-id"]
  otelmw --> httpsem["OTel SemConv HTTP metrics<br/>http.server.request.duration (s)<br/>http.server.active_requests"]
  config --> idemp[("Postgres<br/>app.idempotency_request")]
  config --> evlog[("Postgres audit stream<br/>app.event_log")]
  config --> outbox[("Postgres<br/>app.job_outbox")]
  config --> redis[("Redis optional<br/>cache + coordination")]
  config --> plogs["Platform logs primary<br/>Railway / log drain"]

  outbox --> relay["Outbox relay<br/>publish with confirms<br/>mark sent"]
  relay --> rabbit["RabbitMQ jobs"]
  relay --> otelpub["Message propagation<br/>x-correlation-id + traceparent/tracestate/baggage"]

  rabbit --> workers["Workers<br/>fast/heavy<br/>manual ack"]
  workers --> classifier["Error classifier<br/>permanent->DLQ<br/>transient->retry"]
  classifier --> rabbit
  workers --> pgstate[("Postgres state writes")]
  workers --> plogs
  workers --> otelpub

  projection["Projection consumer<br/>poll by created_at,id"] --> evlog
  projection --> checkpoint[("Postgres<br/>app.event_consumer_checkpoint")]
  projection --> plogs
  projection --> otelpub

  operator["Operators"] --> replay["DLQ replay tool<br/>rate limit + audit"]
  operator --> dbtools["DB tools<br/>replay/export/restore validate"]
  replay --> rabbit
  dbtools --> evlog

  otelmw --> collector["OTel Collector (Railway internal)<br/>OTLP receiver + batch + memory_limiter"]
  otelpub --> collector
  collector --> grafana["Grafana Cloud<br/>traces + metrics"]

  github["GitHub repo + PR"] --> gha["GitHub Actions currently disabled<br/>(*.yml.disabled)"]
  evlog -. "optional future mirror" .-> kafka["Kafka optional future<br/>not active"]
end

subgraph DELIVERY["Delivery and Secret Gates (when workflows are re-enabled)"]
  direction TB

  ci["rust-ci gates<br/>fmt + clippy + test + build<br/>migration validate + container build check<br/>sqlx offline verify + actionlint<br/>secret-scan required"]
  secscan["Secret scanner rules<br/>placeholder enforcement<br/>credential URL detection<br/>token-like assignment detection"]
  deploy["deploy preflight<br/>required secret presence<br/>least-privilege scope checks<br/>OTEL_ENABLED=>endpoint+headers required"]
  migrate["Migration step only<br/>has DATABASE_MIGRATION_URL"]
  runtimeenv["Runtime services only<br/>have DATABASE_RUNTIME_URL"]
  otelsecret["Telemetry secret scope<br/>OTEL_EXPORTER_OTLP_HEADERS (preferred)<br/>OTEL_HEADERS fallback"]

  ci --> secscan
  secscan --> deploy
  deploy --> migrate
  deploy --> runtimeenv
  deploy --> otelsecret
end

subgraph DETAILS["Reference Panels"]
  direction LR

  naming["Naming contract<br/>system: banji-core<br/>env: dev|staging|prod<br/>region: kh-pp<br/>topics/queues omit region"]
  template["Tracked env policy<br/>secret keys use __SET_IN_PLATFORM_SECRET__<br/>or documented empty only"]
  matrix["Least-privilege secret matrix<br/>api/worker/scheduler/projection-consumer/outbox-relay<br/>outbox-relay current phase: no RABBIT_URL"]
  redaction["Redaction contract<br/>sensitive key/header masking<br/>and URL userinfo stripping"]
  rabbitDetail["Rabbit topology<br/>{system}.{env}.jobs + .dlx<br/>fast: primary + retry.1(30s) + retry.2(5m) + retry.3(30m) + dlq<br/>heavy: primary + retry.1(30s) + retry.2(5m) + retry.3(30m) + dlq"]
  pgDetail["Postgres objects<br/>_sqlx_migrations<br/>app.idempotency_request<br/>app.event_log (+ created_at,id replay index)<br/>app.event_consumer_checkpoint<br/>app.job_outbox<br/>app.event_log_archive_export_cursor<br/>app.event_log_archive (optional)"]
  redisDetail["Redis behavior<br/>optional + fail-open/fail-fast<br/>timeouts + circuit breaker<br/>TTL jitter + single-flight"]
  loggingSplit["Logging split<br/>Operational logs -> platform sink<br/>Audit/replay events -> Postgres app.event_log"]
  obsDetail["Observability baseline<br/>services -> OTLP collector -> Grafana Cloud<br/>W3C propagation + correlation_id<br/>resource attrs include deployment.id"]
  cardinality["Cardinality budget<br/>http.route templated (no raw path)<br/>job_type/workload/stream/consumer bounded<br/>no user data in metric labels"]
end

api -. "contract" .-> naming
api -. "template boundary" .-> template
api -. "service scope" .-> matrix
config -. "redaction" .-> redaction
rabbit -. "topology" .-> rabbitDetail
pgstate -. "schema" .-> pgDetail
redis -. "runtime" .-> redisDetail
evlog -. "audit interface" .-> loggingSplit
plogs -. "ops logging" .-> loggingSplit
gha -. "release gates" .-> ci
collector -. "pipeline" .-> obsDetail
httpsem -. "metric labels" .-> cardinality

