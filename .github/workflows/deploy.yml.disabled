name: deploy

on:
  workflow_call:
    inputs:
      image_ref:
        required: true
        type: string
      image_digest:
        required: true
        type: string
      commit_sha:
        required: true
        type: string
      migration_checksum:
        required: true
        type: string
  workflow_dispatch:
    inputs:
      image_ref:
        description: "Pinned image reference (ghcr.io/...@sha256:...)"
        required: true
        type: string
      image_digest:
        description: "Image digest (sha256:...)"
        required: true
        type: string
      commit_sha:
        description: "Commit SHA used to build the artifact"
        required: true
        type: string
      migration_checksum:
        description: "Migration checksum from build"
        required: true
        type: string

permissions:
  contents: read

jobs:
  deploy-staging:
    runs-on: ubuntu-latest
    environment: staging
    concurrency:
      group: deploy-staging
      cancel-in-progress: false
    env:
      IMAGE_REF: ${{ inputs.image_ref || github.event.inputs.image_ref }}
      IMAGE_DIGEST: ${{ inputs.image_digest || github.event.inputs.image_digest }}
      COMMIT_SHA: ${{ inputs.commit_sha || github.event.inputs.commit_sha }}
      MIGRATION_CHECKSUM: ${{ inputs.migration_checksum || github.event.inputs.migration_checksum }}
      RAILWAY_SERVICE_ID: ${{ secrets.RAILWAY_STAGING_SERVICE_ID }}
      RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}
      RAILWAY_PROJECT_ID: ${{ secrets.RAILWAY_PROJECT_ID }}
    steps:
      - uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332
      - name: Preflight required deploy secrets
        env:
          DATABASE_MIGRATION_URL: ${{ secrets.DATABASE_MIGRATION_URL }}
          DATABASE_RUNTIME_URL: ${{ secrets.DATABASE_RUNTIME_URL }}
          OTEL_ENABLED: ${{ vars.OTEL_ENABLED }}
          OTEL_EXPORTER_OTLP_ENDPOINT: ${{ vars.OTEL_EXPORTER_OTLP_ENDPOINT }}
          OTEL_EXPORTER_OTLP_HEADERS: ${{ secrets.OTEL_EXPORTER_OTLP_HEADERS }}
        run: |
          test -n "$DATABASE_MIGRATION_URL" || (echo "missing DATABASE_MIGRATION_URL" >&2; exit 1)
          test -n "$DATABASE_RUNTIME_URL" || (echo "missing DATABASE_RUNTIME_URL" >&2; exit 1)
          test "$DATABASE_MIGRATION_URL" != "$DATABASE_RUNTIME_URL" || (echo "migration and runtime credentials must be distinct" >&2; exit 1)
          if [[ "${OTEL_ENABLED,,}" == "true" ]]; then
            test -n "$OTEL_EXPORTER_OTLP_ENDPOINT" || (echo "missing OTEL_EXPORTER_OTLP_ENDPOINT while OTEL_ENABLED=true" >&2; exit 1)
            test -n "$OTEL_EXPORTER_OTLP_HEADERS" || (echo "missing OTEL_EXPORTER_OTLP_HEADERS while OTEL_ENABLED=true" >&2; exit 1)
          fi
      - name: Assert image reference is digest-pinned
        run: |
          [[ "$IMAGE_REF" =~ @sha256:[a-f0-9]{64}$ ]] || (echo "image_ref must be digest pinned" >&2; exit 1)
      - name: Install migration dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y postgresql-client
          rustup toolchain install stable --profile minimal
          cargo +stable install sqlx-cli --no-default-features --features rustls,postgres
      - name: Run migrations with advisory lock
        env:
          ADVISORY_LOCK_KEY: 184361
          MIGRATION_SENTINEL: /tmp/staging_migration_applied
          DATABASE_MIGRATION_URL: ${{ secrets.DATABASE_MIGRATION_URL }}
          DATABASE_RUNTIME_URL: ${{ secrets.DATABASE_RUNTIME_URL }}
        run: bash tool/ci/migrate_with_lock.sh
      - name: Verify migration step completed
        run: |
          test -f /tmp/staging_migration_applied
      - name: Deploy exact image digest to Railway staging
        run: bash tool/ci/railway_deploy.sh
      - name: Finalize staging traffic shift
        run: echo "staging rollout finalized after migration and deploy"
      - name: Write staging deployment summary
        run: |
          {
            echo "## Staging Deployment";
            echo "- Commit: \\`$COMMIT_SHA\\`";
            echo "- Image: \\`$IMAGE_REF\\`";
            echo "- Digest: \\`$IMAGE_DIGEST\\`";
            echo "- Migration checksum: \\`$MIGRATION_CHECKSUM\\`";
          } >> "$GITHUB_STEP_SUMMARY"

  deploy-prod:
    runs-on: ubuntu-latest
    needs: deploy-staging
    environment: prod
    concurrency:
      group: deploy-prod
      cancel-in-progress: false
    env:
      IMAGE_REF: ${{ inputs.image_ref || github.event.inputs.image_ref }}
      IMAGE_DIGEST: ${{ inputs.image_digest || github.event.inputs.image_digest }}
      COMMIT_SHA: ${{ inputs.commit_sha || github.event.inputs.commit_sha }}
      MIGRATION_CHECKSUM: ${{ inputs.migration_checksum || github.event.inputs.migration_checksum }}
      RAILWAY_SERVICE_ID: ${{ secrets.RAILWAY_PROD_SERVICE_ID }}
      RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}
      RAILWAY_PROJECT_ID: ${{ secrets.RAILWAY_PROJECT_ID }}
    steps:
      - uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332
      - name: Preflight required deploy secrets
        env:
          DATABASE_MIGRATION_URL: ${{ secrets.DATABASE_MIGRATION_URL }}
          DATABASE_RUNTIME_URL: ${{ secrets.DATABASE_RUNTIME_URL }}
          OTEL_ENABLED: ${{ vars.OTEL_ENABLED }}
          OTEL_EXPORTER_OTLP_ENDPOINT: ${{ vars.OTEL_EXPORTER_OTLP_ENDPOINT }}
          OTEL_EXPORTER_OTLP_HEADERS: ${{ secrets.OTEL_EXPORTER_OTLP_HEADERS }}
        run: |
          test -n "$DATABASE_MIGRATION_URL" || (echo "missing DATABASE_MIGRATION_URL" >&2; exit 1)
          test -n "$DATABASE_RUNTIME_URL" || (echo "missing DATABASE_RUNTIME_URL" >&2; exit 1)
          test "$DATABASE_MIGRATION_URL" != "$DATABASE_RUNTIME_URL" || (echo "migration and runtime credentials must be distinct" >&2; exit 1)
          if [[ "${OTEL_ENABLED,,}" == "true" ]]; then
            test -n "$OTEL_EXPORTER_OTLP_ENDPOINT" || (echo "missing OTEL_EXPORTER_OTLP_ENDPOINT while OTEL_ENABLED=true" >&2; exit 1)
            test -n "$OTEL_EXPORTER_OTLP_HEADERS" || (echo "missing OTEL_EXPORTER_OTLP_HEADERS while OTEL_ENABLED=true" >&2; exit 1)
          fi
      - name: Assert image reference is digest-pinned
        run: |
          [[ "$IMAGE_REF" =~ @sha256:[a-f0-9]{64}$ ]] || (echo "image_ref must be digest pinned" >&2; exit 1)
      - name: Install migration dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y postgresql-client
          rustup toolchain install stable --profile minimal
          cargo +stable install sqlx-cli --no-default-features --features rustls,postgres
      - name: Run migrations with advisory lock
        env:
          ADVISORY_LOCK_KEY: 184361
          MIGRATION_SENTINEL: /tmp/prod_migration_applied
          DATABASE_MIGRATION_URL: ${{ secrets.DATABASE_MIGRATION_URL }}
          DATABASE_RUNTIME_URL: ${{ secrets.DATABASE_RUNTIME_URL }}
        run: bash tool/ci/migrate_with_lock.sh
      - name: Verify migration step completed
        run: |
          test -f /tmp/prod_migration_applied
      - name: Deploy exact image digest to Railway prod
        run: bash tool/ci/railway_deploy.sh
      - name: Finalize prod traffic shift
        run: echo "prod rollout finalized after migration and deploy"
      - name: Write prod deployment summary
        run: |
          {
            echo "## Production Deployment";
            echo "- Commit: \\`$COMMIT_SHA\\`";
            echo "- Image: \\`$IMAGE_REF\\`";
            echo "- Digest: \\`$IMAGE_DIGEST\\`";
            echo "- Migration checksum: \\`$MIGRATION_CHECKSUM\\`";
          } >> "$GITHUB_STEP_SUMMARY"
