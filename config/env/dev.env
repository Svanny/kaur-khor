BANJI_SYSTEM=banji-core
BANJI_ENV=dev
BANJI_REGION=kh-pp
BANJI_TENANT=default
BANJI_DEPLOYMENT_ID=local-dev
BANJI_SERVICE=api
APP_ROLE=api
# Worker / relay / projection roles use the same template keys with a different APP_ROLE value.
# Allowed roles: api | event-relay | projection-consumer | worker

# Secret values: set in platform secret store only.
DATABASE_RUNTIME_URL=__SET_IN_PLATFORM_SECRET__
REDIS_URL=__SET_IN_PLATFORM_SECRET__
RABBIT_URL=__SET_IN_PLATFORM_SECRET__
OBJECT_STORAGE_ACCESS_KEY=__SET_IN_PLATFORM_SECRET__
OBJECT_STORAGE_SECRET_KEY=__SET_IN_PLATFORM_SECRET__
OTEL_HEADERS=
OTEL_EXPORTER_OTLP_HEADERS=
EDGE_ORIGIN_AUTH_SECRET=__SET_IN_PLATFORM_SECRET__
EDGE_ORIGIN_AUTH_SECRET_NEXT=

AUTH_ENABLED=false
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_TIMEOUT_MS=1000
AUTH_CLOCK_SKEW_SECONDS=30
IDEMPOTENCY_RETENTION_DAYS=30

DATABASE_RUNTIME_ENDPOINT_KIND=direct
PGBOUNCER_POOL_MODE=session
SQLX_POOL_MAX_CONNECTIONS=10
SQLX_POOL_MIN_CONNECTIONS=1
SQLX_POOL_ACQUIRE_TIMEOUT_MS=2000
SQLX_POOL_CONNECT_TIMEOUT_MS=2000
SQLX_POOL_IDLE_TIMEOUT_SECONDS=300
SQLX_POOL_MAX_LIFETIME_SECONDS=1800
POSTGRES_CONNECTION_BUDGET_TOTAL=80

EDGE_ENFORCEMENT_ENABLED=false
EDGE_ORIGIN_AUTH_HEADER_NAME=x-banji-edge-auth
EDGE_RATE_LIMIT_ENABLED=true
EDGE_RATE_LIMIT_WINDOW_SECONDS=60
EDGE_RATE_LIMIT_READ_MAX=120
EDGE_RATE_LIMIT_USER_READ_MAX=240
EDGE_RATE_LIMIT_USER_WRITE_MAX=60
EDGE_RATE_LIMIT_DEVICE_READ_MAX=120
EDGE_RATE_LIMIT_DEVICE_WRITE_MAX=30
EDGE_RATE_LIMIT_FALLBACK_MAX_KEYS=10000
EDGE_RATE_LIMIT_KEY_TTL_SECONDS=300
EDGE_RATE_LIMIT_REDIS_PREFIX=rate-limit
EDGE_RATE_LIMIT_FAILOVER_ENABLED=true
EDGE_BACKPRESSURE_ENABLED=true
EDGE_BACKPRESSURE_POLL_INTERVAL_MS=1000
EDGE_BACKPRESSURE_RETRY_AFTER_SECONDS=5
EDGE_BACKPRESSURE_CONSECUTIVE_UNHEALTHY=2
EDGE_BACKPRESSURE_CONSECUTIVE_HEALTHY=2
EDGE_BACKPRESSURE_JOB_OUTBOX_PENDING_MAX=1000
EDGE_BACKPRESSURE_JOB_OUTBOX_OLDEST_AGE_SECONDS_MAX=30
EDGE_BACKPRESSURE_JOB_RUN_PENDING_MAX=2000
EDGE_BACKPRESSURE_JOB_RUN_OLDEST_AGE_SECONDS_MAX=60
EDGE_BACKPRESSURE_KAFKA_PENDING_MAX=500
EDGE_BACKPRESSURE_KAFKA_OLDEST_AGE_SECONDS_MAX=30
EDGE_REQUEST_MAX_BYTES=262144
EDGE_WRITE_REQUEST_MAX_BYTES=65536
EDGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
EDGE_TRUST_FORWARDED_CLIENT_IP=false

CACHE_ENABLED=true
CACHE_SCHEMA_VERSION=v1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_TTL_JITTER_SECONDS=30
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=50
REDIS_CIRCUIT_ERROR_THRESHOLD=20
REDIS_CIRCUIT_WINDOW_SECONDS=30
REDIS_CIRCUIT_COOLDOWN_SECONDS=60
REDIS_LOG_RATE_LIMIT_SECONDS=30
EVENT_PAYLOAD_MAX_BYTES=65536
EVENT_RELAY_BATCH_SIZE=100
EVENT_RELAY_POLL_INTERVAL_MS=500
EVENT_RELAY_RETRY_BACKOFF_MS=1000
EVENT_RELAY_MAX_BACKOFF_MS=60000
EVENT_RELAY_BLOCK_AFTER_ATTEMPTS=25
EVENT_OUTBOX_PUBLISHED_RETENTION_DAYS=7
EVENT_CONSUMER_SERVICE_NAME=projection-consumer
EVENT_CONSUMER_NAME=inventory-projector
EVENT_CONSUMER_STREAM_NAME=banji-core.dev.inventory-updated
EVENT_CONSUMER_BATCH_SIZE=100
EVENT_CONSUMER_POLL_INTERVAL_MS=500
EVENT_CONSUMER_INVALID_POLICY=halt
EVENT_CONSUMER_RUN_MODE=continuous
EVENT_CONSUMER_REPLAY_FROM_ID=0
EVENT_CONSUMER_REPLAY_TO_ID=
EVENT_CONSUMER_REPLAY_RESET_CHECKPOINT=false
EVENT_CONSUMER_REPLAY_TRUNCATE_PROJECTION=false
EVENT_LOG_RETENTION_DAYS=30
EVENT_LOG_PRUNE_BATCH_SIZE=1000
EVENT_LOG_REPLAY_BATCH_SIZE=1000
EVENT_LOG_ARCHIVE_PREFIX=event-log
EVENT_LOG_ARCHIVE_RETENTION_DAYS=365
EVENT_LOG_ARCHIVE_ENCRYPTION_REQUIRED=true
RABBIT_VHOST=/
RABBIT_EXCHANGE_JOBS=banji-core.dev.jobs
RABBIT_EXCHANGE_JOBS_REPLAY=banji-core.dev.jobs.replay
RABBIT_DLX_EXCHANGE=banji-core.dev.jobs.dlx
RABBIT_RETRY_1_TTL_MS=30000
RABBIT_RETRY_2_TTL_MS=300000
RABBIT_RETRY_3_TTL_MS=1800000
RABBIT_PREFETCH_FAST=20
RABBIT_PREFETCH_HEAVY=2
RABBIT_REPLAY_PREFETCH_FAST=5
RABBIT_REPLAY_PREFETCH_HEAVY=1
RABBIT_MAX_ATTEMPTS=4
RABBIT_REPLAY_MAX_MESSAGES=10
RABBIT_REPLAY_RATE_PER_MIN=60
RABBIT_REPLAY_RETAIN_ATTEMPT=true
RABBIT_REPLAY_TARGET_EXCHANGE=banji-core.dev.jobs.replay
RABBIT_REPLAY_TARGET_ROUTING_KEY=job.fast.replay
OBSERVABILITY_RABBIT_QUEUE_POLL_INTERVAL_MS=15000
OBSERVABILITY_POSTGRES_LOCK_POLL_INTERVAL_MS=15000
OBSERVABILITY_JOB_PRESSURE_POLL_INTERVAL_MS=15000
RABBIT_MANAGEMENT_API_BASE_URL=
WORKER_ID=worker-local
WORKER_ENABLED_CLASSES=fast,heavy
WORKER_POLL_INTERVAL_MS=250
WORKER_SHUTDOWN_GRACE_SECONDS=30
JOB_ATTEMPT_LEASE_SECONDS=60
JOB_ATTEMPT_HEARTBEAT_SECONDS=15
JOB_HANDLER_MAX_RUNTIME_SECONDS=
JOB_RESULT_KAFKA_ENABLED=false
JOB_RESULT_KAFKA_TOPIC_PREFIX=
WORKER_CONSUME_REPLAY_QUEUES=false
WORKER_JOB_RELAY_BATCH_SIZE=100
ALGORITHM_ROLLOUT_HASH_SALT=dev-local-salt
ALGORITHM_ROLLOUT_HASH_SALT_VERSION=dev-local
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_ARTIFACTS=banji-core-dev-kh-pp-artifacts
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ARTIFACT_PREFIX=worker
OBJECT_STORAGE_ARTIFACT_RETENTION_DAYS=30
OBJECT_STORAGE_CONNECT_TIMEOUT_MS=3000
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=30000
OBJECT_STORAGE_MAX_ARTIFACT_BYTES=104857600
ARTIFACT_TMP_DIR=/tmp/banji-artifacts

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=30000
