BANJI_SYSTEM=banji-core
BANJI_ENV=staging
BANJI_REGION=kh-pp
BANJI_TENANT=default
BANJI_DEPLOYMENT_ID=staging-unknown
BANJI_SERVICE=api

# Secret values: set in platform secret store only.
DATABASE_RUNTIME_URL=__SET_IN_PLATFORM_SECRET__
REDIS_URL=__SET_IN_PLATFORM_SECRET__
RABBIT_URL=__SET_IN_PLATFORM_SECRET__
OBJECT_STORAGE_ACCESS_KEY=__SET_IN_PLATFORM_SECRET__
OBJECT_STORAGE_SECRET_KEY=__SET_IN_PLATFORM_SECRET__
OTEL_HEADERS=__SET_IN_PLATFORM_SECRET__

CACHE_ENABLED=true
CACHE_SCHEMA_VERSION=v1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_TTL_JITTER_SECONDS=30
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=50
REDIS_CIRCUIT_ERROR_THRESHOLD=20
REDIS_CIRCUIT_WINDOW_SECONDS=30
REDIS_CIRCUIT_COOLDOWN_SECONDS=60
REDIS_LOG_RATE_LIMIT_SECONDS=30
EVENT_PAYLOAD_MAX_BYTES=65536
RABBIT_VHOST=/
RABBIT_EXCHANGE_JOBS=banji-core.staging.jobs
RABBIT_DLX_EXCHANGE=banji-core.staging.jobs.dlx
RABBIT_RETRY_1_TTL_MS=30000
RABBIT_RETRY_2_TTL_MS=300000
RABBIT_RETRY_3_TTL_MS=1800000
RABBIT_PREFETCH_FAST=20
RABBIT_PREFETCH_HEAVY=2
RABBIT_MAX_ATTEMPTS=4
